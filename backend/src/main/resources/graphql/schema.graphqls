type Query {
    "The signed-in user"
    me: User
    "Every country a company can be in, with its currency"
    countries: [Country!]!
    """
    A company the signed-in user can access, with their role in it. Fails with extensions { code: "not_found" }
    for a company they can't access, exactly as for one that doesn't exist, and with "company_suspended" for a
    suspended company.

    Company-scoped fields fail with these codes: "not_found"; "forbidden" when the user's role doesn't allow
    it; "company_read_only" when it would change a read-only company; "company_suspended".
    """
    company(id: ID!): UserCompany
    "The company's people: its owner first, then its members by email. Anyone in the company can see them."
    members(companyId: ID!): [Member!]!
    "The company's open invitations, for its owner and admins"
    invitations(companyId: ID!): [Invitation!]!
    "The company's settings, for its owner and admins (forbidden for others)"
    companySettings(companyId: ID!): CompanySettings
}

type Mutation {
    """
    Creates a company owned by the signed-in user. Only a name and a country are needed; the currency follows
    from the country. Bad input fails with extensions { code: "invalid_input", field, reason }.
    """
    createCompany(input: CreateCompanyInput!): Company!
    "Sets the language the signed-in user sees InvoHub and gets emails in"
    setLanguage(language: Language!): User!
    """
    Changes a member's role; needs the owner or an admin. The owner role can't be given (invalid_input, field
    "role", reason "owner"); the owner's and the user's own role can't be changed (not_allowed, reason "owner"
    or "self"); someone who isn't a member is member_not_found.
    """
    changeMemberRole(companyId: ID!, userId: ID!, role: CompanyRole!): Member!
    """
    Removes a member from the company; needs the owner or an admin. Never the owner, nor the user themselves
    (they leave instead): not_allowed with reason "owner" or "self".
    """
    removeMember(companyId: ID!, userId: ID!): Boolean!
    "Leaves the company. The owner can't (not_allowed, reason \"owner_cannot_leave\"): they transfer ownership first."
    leaveCompany(companyId: ID!): Boolean!
    """
    Invites an email address to one or more companies, each with a role; needs the owner or an admin of each.
    All or nothing, including the email: one email about all of them, whose button signs the person in on their
    Invitations page. Refusals: invalid_input (field "email", "companies" or "role"); invitation_refused with a
    reason ("already_member", "already_invited", "daily_limit" for the inviter, "recipient_daily_limit" for the
    address) and the companyId it is about, if any; email_delivery_failed if the email couldn't be sent.
    """
    inviteMembers(input: InviteMembersInput!): [Invitation!]!
    "Revokes an open invitation to the company; needs the owner or an admin. Otherwise invitation_not_found."
    revokeInvitation(companyId: ID!, invitationId: ID!): Boolean!
    "Accepts one of the signed-in user's invitations, joining the company. Otherwise invitation_not_found."
    acceptInvitation(invitationId: ID!): UserCompany!
    declineInvitation(invitationId: ID!): Boolean!
    """
    Renames the company and moves it to another country, whose currency it then uses; moving clears the tax ID
    and the country's own details. Owner or admin. invalid_input: field "name" (required, too_long) or "country"
    (unknown).
    """
    updateCompanyProfile(companyId: ID!, input: CompanyProfileInput!): CompanySettings!
    """
    Replaces the business details; blank clears one. Owner or admin. invalid_input with the field ("legalName",
    "street", "city", "postalCode", "taxId" or a country detail's key) and the reason (too_long, invalid,
    check_digit).
    """
    updateBusinessDetails(companyId: ID!, input: BusinessDetailsInput!): CompanySettings!
    """
    Owner or admin. invalid_input: "bankName" (required, too_long) or "iban" (invalid, duplicate);
    not_allowed with reason "too_many_bank_accounts".
    """
    addBankAccount(companyId: ID!, input: BankAccountInput!): CompanySettings!
    "Owner or admin. Otherwise bank_account_not_found."
    removeBankAccount(companyId: ID!, bankAccountId: ID!): CompanySettings!
    """
    Step 1 of changing the logo: where the browser uploads the file itself, for one file of this type and size.
    Then changeLogo with the uploadId. Owner or admin. invalid_input "logo": empty, too_large, unsupported_type.
    """
    prepareLogoUpload(companyId: ID!, input: LogoUploadInput!): LogoUpload!
    """
    Step 2: makes the uploaded file the logo, once checked to be a PNG, JPEG or WebP image of at most 1 MB.
    invalid_input "logo": upload_missing (never uploaded, or expired), too_large, unsupported_type.
    """
    changeLogo(companyId: ID!, uploadId: ID!): CompanySettings!
    "Owner or admin"
    removeLogo(companyId: ID!): CompanySettings!
}

type User {
    id: ID!
    email: String!
    "For the app and the user's emails"
    language: Language!
    "Companies the user owns or is a member of, by name"
    companies: [UserCompany!]!
    "Open invitations for the user's email address, oldest first"
    invitations: [Invitation!]!
}

enum Language {
    EN
    EL
}

"A company the user can access, with their role in it"
type UserCompany {
    company: Company!
    role: CompanyRole!
}

type Company {
    id: ID!
    name: String!
    "ISO 3166-1 alpha-2, e.g. GR"
    country: String!
    "ISO 4217, e.g. EUR"
    currency: String!
    status: CompanyStatus!
    "Whether InvoHub supports invoicing in the company's country yet"
    invoicingSupported: Boolean!
}

type CompanySettings {
    company: Company!
    legalName: String
    address: Address!
    taxId: String
    "The country's own details, every key it has (Greece: taxOffice, mainActivity), in form order"
    countryDetails: [CountryDetail!]!
    bankAccounts: [BankAccount!]!
    "Where anyone can see the logo, or null without one; a new logo gets a new URL"
    logoUrl: String
    "What's left before the company can issue invoices, in order"
    invoicingSetup: [SetupStep!]!
}

type Address {
    street: String
    city: String
    postalCode: String
}

type CountryDetail {
    key: String!
    value: String
}

type BankAccount {
    id: ID!
    bankName: String!
    iban: String!
}

"One item of the invoicing setup checklist. available is false for steps that can't be done in InvoHub yet."
type SetupStep {
    key: String!
    done: Boolean!
    available: Boolean!
}

input CompanyProfileInput {
    name: String!
    "ISO 3166-1 alpha-2"
    country: String!
}

input BusinessDetailsInput {
    legalName: String
    street: String
    city: String
    postalCode: String
    taxId: String
    countryDetails: [CountryDetailInput!]
}

input CountryDetailInput {
    key: String!
    value: String
}

input LogoUploadInput {
    "image/png, image/jpeg or image/webp"
    contentType: String!
    "In bytes"
    size: Int!
}

"Where to upload a file: PUT it to url with exactly these headers, before expiresAt"
type LogoUpload {
    uploadId: ID!
    url: String!
    headers: [UploadHeader!]!
    "ISO-8601"
    expiresAt: String!
}

type UploadHeader {
    name: String!
    value: String!
}

input BankAccountInput {
    bankName: String!
    iban: String!
}

type Invitation {
    id: ID!
    "The address invited"
    email: String!
    role: CompanyRole!
    company: Company!
    "The inviter's email address"
    invitedBy: String!
    "ISO-8601"
    expiresAt: String!
}

input InviteMembersInput {
    email: String!
    companies: [InvitationCompanyInput!]!
}

input InvitationCompanyInput {
    companyId: ID!
    role: CompanyRole!
}

type Member {
    userId: ID!
    email: String!
    role: CompanyRole!
    "When they got access, ISO-8601"
    since: String!
}

enum CompanyStatus {
    ACTIVE
    "Unpaid: can be viewed and exported, and billing managed, but not changed"
    READ_ONLY
    "By InvoHub staff: can't be used"
    SUSPENDED
}

enum CompanyRole {
    OWNER
    ADMIN
    MEMBER
    VIEWER
}

type Country {
    "ISO 3166-1 alpha-2"
    code: String!
    "ISO 4217"
    currency: String!
    invoicingSupported: Boolean!
}

input CreateCompanyInput {
    name: String!
    "ISO 3166-1 alpha-2"
    country: String!
}
