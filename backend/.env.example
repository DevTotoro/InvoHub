# Host
HOST=localhost

# Database
DB_USER=root
DB_PASSWORD=root
DB_NAME=postgres
DB_PORT=5432

# Redis
REDIS_PORT=6379

# Mailpit
MAILPIT_SMTP_PORT=1025

# Spring Boot
SPRING_DATASOURCE_URL=jdbc:postgresql://${HOST}:${DB_PORT}/${DB_NAME}
SPRING_DATASOURCE_USERNAME=${DB_USER}
SPRING_DATASOURCE_PASSWORD=${DB_PASSWORD}

SPRING_REDIS_HOST=${HOST}
SPRING_REDIS_PORT=${REDIS_PORT}

SPRING_MAIL_HOST=${HOST}
SPRING_MAIL_PORT=${MAILPIT_SMTP_PORT}
