# Read by docker compose and, under the "local" Spring profile, by the backend itself
# (see application-local.yaml). Copy to .env and adjust as needed.

# Host
HOST=localhost

# Database. DB_USER owns the schema and runs the migrations; the app itself connects as DB_APP_USER,
# which can read and write data but not change the schema.
DB_USER=root
DB_PASSWORD=root
DB_APP_USER=invohub_app
DB_APP_PASSWORD=invohub_app
DB_NAME=postgres
DB_PORT=5432

# Redis
REDIS_PORT=6379

# Mailpit
MAILPIT_SMTP_PORT=1025
